{
  "name": "gitmate",
  "version": "1.0.0",
  "description": "GitMate — 一个现代化、简单易用的 Git 桌面客户端",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.myf.gitmate",
    "productName": "GitMate",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**",
      "build/icon.ico"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "portable"
      ]
    },
    "portable": {
      "artifactName": "GitMate-Portable.exe"
    }
  },
  "author": "myf",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^26.18.0"
  }
}
